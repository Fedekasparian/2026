  <info>
    <name>03-educacion-primaria-2023</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Filtra 'Primary education, duration (years)' para 2023, descarta sin dato y ordena desc.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
