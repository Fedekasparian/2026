      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Quitar duplicados</from>
      <to>Numerar</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Numerar</from>
      <to>Paises</to>
      <enabled>Y</enabled>
    </hop>
  </order>
